# ─── MySQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=bank_ai_agent

# ─── AWS / Bedrock ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional: use a named profile instead of keys
# AWS_PROFILE=default

# Bedrock model ID
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Bedrock Guardrails (optional — leave blank to disable)
# Create a guardrail in the AWS Bedrock console and paste the ID + version here
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── Agent Behaviour ──────────────────────────────────────
MAX_AGENT_ITERATIONS=10
AGENT_TEMPERATURE=0.1

# ─── MCP REST Server ──────────────────────────────────────
# Docker overrides this to http://mcp-server:8000 automatically
MCP_SERVER_URL=http://localhost:8000

# ─── OAuth Authentication ─────────────────────────────────
# Set ENABLE_AUTH=true to require a Bearer token on all MCP endpoints.
# Leave false (default) for open access (local dev / Docker-only setups).
ENABLE_AUTH=false

# Client credentials — used to obtain a token via POST /token
OAUTH_CLIENT_ID=bank-ai-agent-client
OAUTH_CLIENT_SECRET=change-me-strong-secret

# Secret used to sign/verify JWT tokens (generate with: openssl rand -hex 32)
OAUTH_JWT_SECRET=change-me-jwt-secret

# How long (seconds) an issued token is valid (default: 1 hour)
OAUTH_TOKEN_EXPIRY=3600
